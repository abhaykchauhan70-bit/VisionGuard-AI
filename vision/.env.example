# Copy this file to .env and fill in your real values. Never commit .env itself.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=visionguard

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=60

UPLOAD_DIR=uploads
RESULTS_DIR=results
MODELS_DIR=models
MAX_UPLOAD_SIZE_MB=200

FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
